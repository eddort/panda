new file mode 100644
index 000000000..01c52ff71
--- /dev/null
+++ b/.github/workflows/tests-integration-panda.yml
@@ -0,0 +1,72 @@
+name: Integration Tests Panda
+
+on:
+  workflow_dispatch:
+    inputs:
+      image:
+        description: Published Gloas image pinned by digest (ghcr.io/eddort/panda-gloas@sha256:...)
+        required: true
+        type: string
+
+permissions:
+  contents: read
+  packages: read
+
+jobs:
+  select:
+    runs-on: ubuntu-24.04
+    outputs:
+      image: ${{ steps.select.outputs.image }}
+    steps:
+      - id: select
+        env:
+          PANDA_IMAGE: ${{ inputs.image }}
+        run: |
+          [[ "$PANDA_IMAGE" =~ ^ghcr\.io/eddort/panda-gloas@sha256:[a-f0-9]{64}$ ]]
+          echo "image=$PANDA_IMAGE" >> "$GITHUB_OUTPUT"
+
+  test:
+    needs: select
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    env:
+      PANDA_URL: http://127.0.0.1:18547
+      NODE_OPTIONS: --max_old_space_size=10240
+    services:
+      panda:
+        image: ${{ needs.select.outputs.image }}
+        credentials:
+          username: ${{ github.actor }}
+          password: ${{ secrets.PANDA_REGISTRY_TOKEN || secrets.GITHUB_TOKEN }}
+        ports:
+          - 127.0.0.1:18547:8545
+        options: --privileged --stop-timeout 120 --label io.panda.id=lido-ci-${{ github.run_id }}-${{ github.run_attempt }}
+    steps:
+      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6.0.3
+      - name: Common setup
+        uses: ./.github/workflows/setup
+      - name: Install foundry
+        uses: foundry-rs/foundry-toolchain@908c540300062bd5a7e473851cdb4282204cee09 # v1.9.1
+        with:
+          version: v1.7.1
+      - name: Install just
+        run: cargo install just --locked
+      - run: cp .env.example .env
+      - name: Check external-service client
+        run: node --test scripts/tests/panda-client.test.cjs
+      # The suite checks block zero and owns deployment, warmup, automine and time controls.
+      - name: Run existing Panda integration suite
+        run: yarn test:integration:panda --bail
+      - name: Save Panda service logs
+        if: always()
+        env:
+          SERVICE_ID: ${{ job.services.panda.id }}
+        run: |
+          mkdir -p .local/panda
+          docker logs "$SERVICE_ID" > .local/panda/service.log 2>&1
+      - name: Upload Panda evidence
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        with:
+          name: panda-integration-${{ github.run_attempt }}
+          path: .local/panda/
diff --git a/scripts/tests/panda-client.test.cjs b/scripts/tests/panda-client.test.cjs
new file mode 100644
index 000000000..49cfc2a0d
--- /dev/null
+++ b/scripts/tests/panda-client.test.cjs
@@ -0,0 +1,54 @@
+const assert = require("node:assert/strict");
+const { test } = require("node:test");
+const http = require("node:http");
+const fs = require("node:fs/promises");
+const os = require("node:os");
+const path = require("node:path");
+require("ts-node/register/transpile-only");
+const { Panda } = require("../../lib/panda/index.ts");
+
+test("external Panda needs no checkout, preserves fresh genesis and does not own shutdown", async () => {
+  const output = await fs.mkdtemp(path.join(os.tmpdir(), "panda-client-"));
+  const methods = [];
+  let block = "0x0";
+  const server = http.createServer(async (req, res) => {
+    let text = "";
+    for await (const chunk of req) text += chunk;
+    const request = JSON.parse(text);
+    methods.push(request.method);
+    res.setHeader("content-type", "application/json");
+    res.end(
+      JSON.stringify({
+        result:
+          request.method === "status"
+            ? {
+                id: "service-unit",
+                profile: "gloas",
+                bake: "r1",
+                bakeKey: "a".repeat(64),
+                slot: 0,
+                automine: false,
+                el: { number: block },
+              }
+            : null,
+      }),
+    );
+  });
+  await new Promise((resolve) => server.listen(0, "127.0.0.1", resolve));
+  const url = `http://127.0.0.1:${server.address().port}`;
+  try {
+    const panda = await Panda.start({ url, root: "/nonexistent-panda", output, bake: "r1" });
+    assert.equal(panda.url, url);
+    assert.equal(panda.id, "service-unit");
+    await panda.importValidator("{}", "password");
+    await panda.exitValidator(`0x${"ab".repeat(48)}`);
+    await panda.close();
+    assert.deepEqual(methods, ["status", "importValidator", "exitValidator"]);
+    block = "0x1";
+    await assert.rejects(Panda.start({ url, root: "/nonexistent-panda", output, bake: "r1" }), /fresh chain/);
+    assert.equal(methods.includes("shutdown"), false);
+  } finally {
+    await new Promise((resolve) => server.close(resolve));
+    await fs.rm(output, { recursive: true, force: true });
+  }
+});
