#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ ! -x .tools/deno ]; then
  echo 'Run sh scripts/bootstrap.sh first (Deno 2.9.7).' >&2
  exit 1
fi
case "${1-}" in
  run|test|check|lint|fmt|eval|bench|compile|repl|info)
    zap_command="$1"
    shift
    exec .tools/deno "$zap_command" --config deno.runtime.json "$@"
    ;;
  *) exec .tools/deno "$@" ;;
esac
